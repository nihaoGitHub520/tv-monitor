<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面（单 Activity 根布局）：
  - 四分格 2x2（QuadGridView）+ 底部提示条；
  - 单预览 Overlay（SinglePreviewOverlay 管理的视图组，默认隐藏）；
  - Fragment 容器（源管理 / 添加向导 / 设置，叠加在四分格之上，播放不中断）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <com.tvmonitor.ui.QuadGridView
        android:id="@+id/quad_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/hint_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 底部提示条（常显） -->
    <TextView
        android:id="@+id/hint_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_scrim"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/main_hint_bar"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fragment 容器（源管理 / 添加向导 / 设置） -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================== 单预览 Overlay ==================== -->
    <FrameLayout
        android:id="@+id/single_preview_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/single_preview_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:keep_content_on_player_reset="true"
            app:resize_mode="fit"
            app:shutter_background_color="@color/black"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- 左上角 chrome：标题 + 静音 + 信息 overlay（进入预览显示，3s 自动隐藏；Info 键唤出统计再显 3s） -->
        <LinearLayout
            android:id="@+id/single_preview_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/single_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="360dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <!-- 静音按钮（仅当前路，US-09；随左上角 chrome 一同 3s 自动隐藏） -->
                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_background"
                    android:contentDescription="@string/action_mute"
                    android:focusable="false"
                    android:padding="9dp"
                    android:src="@drawable/ic_volume_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/single_preview_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 单预览底部操作提示（每次进入预览显示 5s 后自动消失） -->
        <TextView
            android:id="@+id/single_preview_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/overlay_scrim"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/hint_single_preview"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
