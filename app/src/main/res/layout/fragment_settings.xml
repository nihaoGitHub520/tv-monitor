<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：重连策略 / 播放 / 关于（T5 验收 5） -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ============ 重连策略 ============ -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_section_reconnect" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_reconnect_delays" />

            <EditText
                android:id="@+id/et_delays"
                style="@style/SettingsInput"
                android:inputType="text"
                android:text="5,10,20,40,60" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_max_retries" />

            <EditText
                android:id="@+id/et_max_attempts"
                style="@style/SettingsInput"
                android:text="10" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_keepalive_interval" />

            <EditText
                android:id="@+id/et_keepalive"
                style="@style/SettingsInput"
                android:text="60" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_first_frame_rtsp" />

            <EditText
                android:id="@+id/et_ff_rtsp"
                style="@style/SettingsInput"
                android:text="15" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_first_frame_hls" />

            <EditText
                android:id="@+id/et_ff_hls"
                style="@style/SettingsInput"
                android:text="25" />
        </LinearLayout>

        <!-- ============ 播放 ============ -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_section_playback" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_default_mute" />

            <Switch
                android:id="@+id/switch_mute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_prefer_substream" />

            <Switch
                android:id="@+id/switch_substream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- ============ 系统 ============ -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_section_system" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_autostart" />

            <Switch
                android:id="@+id/switch_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_autostart_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_buffer_mb" />

            <EditText
                android:id="@+id/et_buffer"
                style="@style/SettingsInput"
                android:text="8" />
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_max_resolution" />

        <RadioGroup
            android:id="@+id/rg_max_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_res_1080p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/settings_resolution_1080p"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rb_res_unlimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_resolution_unlimited"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- ============ 关于 ============ -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/settings_section_about" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_log_enabled" />

            <Switch
                android:id="@+id/switch_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/action_save" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
