<?xml version="1.0" encoding="utf-8"?>
<!--
  四分格 2x2 网格（QuadGridView 内部布局）。

  D-pad 焦点矩阵（越界不 wrap，§T4 验收 2）：
  - 声明式 nextFocus（XML 属性，API 24 可用；View.setNextFocus*Id 需 API 26，故不用代码设置）；
  - slot_0：右→slot_1，下→slot_2；左/上无声明（边界不移动）；
  - slot_1：左→slot_0，下→slot_3；
  - slot_2：右→slot_3，上→slot_0；
  - slot_3：左→slot_2，上→slot_1。
-->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quad_grid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.tvmonitor.ui.SlotView
        android:id="@+id/slot_0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_margin="2dp"
        android:layout_row="0"
        android:layout_rowWeight="1"
        android:nextFocusDown="@+id/slot_2"
        android:nextFocusRight="@+id/slot_1" />

    <com.tvmonitor.ui.SlotView
        android:id="@+id/slot_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_margin="2dp"
        android:layout_row="0"
        android:layout_rowWeight="1"
        android:nextFocusDown="@+id/slot_3"
        android:nextFocusLeft="@+id/slot_0" />

    <com.tvmonitor.ui.SlotView
        android:id="@+id/slot_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_columnWeight="1"
        android:layout_margin="2dp"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:nextFocusRight="@+id/slot_3"
        android:nextFocusUp="@+id/slot_0" />

    <com.tvmonitor.ui.SlotView
        android:id="@+id/slot_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_margin="2dp"
        android:layout_row="1"
        android:layout_rowWeight="1"
        android:nextFocusLeft="@+id/slot_2"
        android:nextFocusUp="@+id/slot_1" />

</GridLayout>
